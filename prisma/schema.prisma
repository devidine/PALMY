generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  nickname  String?
  address   String?
  birthday  String?
  createdAt DateTime @default(now())
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int
  description String?
  createdAt   DateTime @default(now())
}
